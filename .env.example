NODE_ENV=development
PORT=3000

# PostgreSQL Connection (local Docker/Podman container)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jaga_warung?schema=public"

# JWT Configuration (generate strong secrets for production)
JWT_ACCESS_SECRET=jaga-warung-super-secret-access-token-key-2026-min-32-chars
JWT_REFRESH_SECRET=jaga-warung-super-secret-refresh-token-key-2026-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS configuration
CORS_ORIGIN=http://localhost:5173

# Cookie Secret for cookie-parser
COOKIE_SECRET=jaga-warung-cookie-secret-key-min-16-chars

# PostgreSQL Container Setup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jaga_warung
POSTGRES_PORT=5432
