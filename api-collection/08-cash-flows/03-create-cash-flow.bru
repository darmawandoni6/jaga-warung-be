meta {
  name: Create Cash Flow Entry
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/cash-flows
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "type": "EXPENSE",
    "amount": 50000,
    "note": "Beli token listrik PLN warung & kantong kresek"
  }
}

assert {
  res.status: in [200, 201]
  res.body.success: eq true
  res.body.data.cashFlow: isDefined
}

script:post-response {
  if (res.body && res.body.data && res.body.data.cashFlow) {
    if (typeof bru.setEnvVar === 'function') {
      bru.setEnvVar("cashFlowId", res.body.data.cashFlow.id);
    }
    if (typeof bru.setVar === 'function') {
      bru.setVar("cashFlowId", res.body.data.cashFlow.id);
    }
  }
}
