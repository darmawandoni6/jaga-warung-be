meta {
  name: List Transactions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/transactions
  body: none
  auth: bearer
}

params:query {
  ~startDate: 2026-10-01
  ~endDate: 2026-10-31
  ~limit: 50
  ~offset: 0
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.transactions: isDefined
}
