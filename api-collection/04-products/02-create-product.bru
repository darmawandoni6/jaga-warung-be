meta {
  name: Create Product
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "barcode": "8999999123456",
    "name": "Indomie Goreng Spesial 85g",
    "buyPrice": 3000,
    "sellPrice": 3500,
    "stock": 40,
    "minStock": 10,
    "type": "Makanan Instan",
    "categoryId": "{{categoryId}}"
  }
}

assert {
  res.status: in [200, 201]
  res.body.success: eq true
}

script:post-response {
  if (res.body && res.body.data && res.body.data.product) {
    if (typeof bru.setEnvVar === 'function') {
      bru.setEnvVar("productId", res.body.data.product.id);
      bru.setEnvVar("productBarcode", res.body.data.product.barcode);
    }
    if (typeof bru.setVar === 'function') {
      bru.setVar("productId", res.body.data.product.id);
      bru.setVar("productBarcode", res.body.data.product.barcode);
    }
  }
}
