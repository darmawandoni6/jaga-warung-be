meta {
  name: List Products
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/products
  body: none
  auth: bearer
}

params:query {
  ~search: Indomie
  ~categoryId: {{categoryId}}
  ~lowStock: false
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.products: isDefined
}
