meta {
  name: List Stock Movements
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/stock-movements
  body: none
  auth: bearer
}

params:query {
  ~productBarcode: {{productBarcode}}
  ~type: RESTOCK
  ~limit: 50
  ~offset: 0
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.movements: isDefined
}
