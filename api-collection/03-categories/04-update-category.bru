meta {
  name: Update Category
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/categories/{{categoryId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Sembako, Minyak & Bumbu Dapur"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.category.name: eq Sembako, Minyak & Bumbu Dapur
}
