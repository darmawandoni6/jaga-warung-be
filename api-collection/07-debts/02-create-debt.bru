meta {
  name: Create Debt (Kasbon)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/debts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "customerName": "Pak RT Bambang",
    "phone": "081298765432",
    "totalDebt": 75000,
    "paidAmount": 25000,
    "note": "Ambil beras 5kg + minyak goreng 1L, janji lunas awal bulan depan"
  }
}

assert {
  res.status: in [200, 201]
  res.body.success: eq true
  res.body.data.debt: isDefined
}

script:post-response {
  if (res.body && res.body.data && res.body.data.debt) {
    if (typeof bru.setEnvVar === 'function') {
      bru.setEnvVar("debtId", res.body.data.debt.id);
    }
    if (typeof bru.setVar === 'function') {
      bru.setVar("debtId", res.body.data.debt.id);
    }
  }
}
