meta {
  name: List Debts (Kasbon)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/debts
  body: none
  auth: bearer
}

params:query {
  ~status: ACTIVE
  ~search: Bambang
  ~limit: 50
  ~offset: 0
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.debts: isDefined
}
