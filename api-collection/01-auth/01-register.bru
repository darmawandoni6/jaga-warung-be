meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "juragan@jagawarung.id",
    "password": "password123",
    "name": "Juragan Warung"
  }
}

assert {
  res.status: in [200, 201]
  res.body.success: eq true
}

script:post-response {
  if (res.body && res.body.data && res.body.data.accessToken) {
    if (typeof bru.setEnvVar === 'function') {
      bru.setEnvVar("token", res.body.data.accessToken);
    }
    if (typeof bru.setVar === 'function') {
      bru.setVar("token", res.body.data.accessToken);
    }
  }
}
